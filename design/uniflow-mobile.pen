{
  "version": "2.13",
  "name": "Uniflow Mobile",
  "children": [
    {
      "type": "frame",
      "id": "loginScreen",
      "x": 0,
      "y": 0,
      "name": "Login",
      "clip": true,
      "width": 390,
      "height": 844,
      "fill": "#0a0a0b",
      "layout": "vertical",
      "gap": 24,
      "padding": [56, 24, 32, 24],
      "alignItems": "center",
      "children": [
        {
          "type": "frame",
          "id": "loginBrand",
          "name": "Brand",
          "layout": "vertical",
          "gap": 12,
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "loginLogoMark",
              "name": "Logo Mark",
              "width": 48,
              "height": 48,
              "cornerRadius": 14,
              "fill": "#ff5c1a",
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "loginLogoLetter",
                  "fill": "#ffffff",
                  "content": "U",
                  "fontFamily": "Inter",
                  "fontSize": 24,
                  "fontWeight": "700"
                }
              ]
            },
            {
              "type": "text",
              "id": "loginBrandName",
              "fill": "#ffffff",
              "content": "Uniflow",
              "fontFamily": "Inter",
              "fontSize": 28,
              "fontWeight": "700",
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "loginTagline",
              "fill": "#666666",
              "content": "University intelligence, in your pocket",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "400",
              "textAlign": "center"
            }
          ]
        },
        {
          "type": "frame",
